# Contact form (api/contact.ts). Set these in Vercel → Project → Settings → Environment Variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
# Optional: where messages go (defaults to SMTP_USER)
CONTACT_TO=
